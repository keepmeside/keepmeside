{
  "$schema": "https://raw.githubusercontent.com/MrLarkyy/Readmint/main/packages/format/schema/design-v0.schema.json",
  "version": 0,
  "title": "A pinned repository in its primary language",
  "description": "Repository metadata shown with the syntax and filename extension of its GitHub primary language.",
  "canvas": {
    "width": 412,
    "height": 204
  },
  "assets": {
    "fonts": {
      "mono": {
        "family": "Geist Mono",
        "src": "fonts/GeistMono-Regular.ttf",
        "weight": 400,
        "licence": {
          "embedding": "allowed",
          "name": "OFL-1.1"
        },
        "fallback": ["nm"]
      },
      "nm": {
        "family": "Noto Sans Mono",
        "src": "fonts/NotoSansMono-Regular.ttf",
        "weight": 400,
        "licence": {
          "embedding": "allowed",
          "name": "OFL-1.1"
        }
      }
    }
  },
  "components": {
    "card": {
      "props": {
        "theme": {
          "type": "enum",
          "values": ["light", "dark"],
          "default": "light"
        },
        "slot": {
          "type": "number",
          "default": 0
        }
      },
      "layers": [
        {
          "type": "group",
          "let": {
            "rs": "{{ github.pinned || github.repositories }}",
            "repo": "{{ rs[props.slot] }}"
          },
          "children": [
            {
              "type": "rect",
              "x": 0.5,
              "y": 0.5,
              "width": 411,
              "height": 203,
              "fill": "{{ props.theme == \"dark\" ? \"#12161d\" : \"#FAFAFA\" }}",
              "radius": 10,
              "stroke": "{{ props.theme == \"dark\" ? \"#26272B\" : \"#E4E4E7\" }}",
              "strokeWidth": 1
            },
            {
              "type": "group",
              "if": "{{ repo }}",
              "let": {
                "language": "{{ repo.primaryLanguage.name || \"Not specified\" }}",
                "extension": "{{ language == \"Rust\" ? \".rs\" : language == \"Java\" ? \".java\" : language == \"Go\" ? \".go\" : language == \"TypeScript\" ? \".ts\" : language == \"JavaScript\" ? \".js\" : language == \"Shell\" ? \".sh\" : language == \"Python\" ? \".py\" : language == \"Kotlin\" ? \".kt\" : \".txt\" }}",
                "summary": "{{ (repo.description || \"No repository description.\") | truncateWidth(336, \"mono\", 11) }}",
                "quotedName": "{{ '\"' + ((repo.name || \"\") | truncate(34)) + '\"' }}",
                "rustRows": "{{ [[\"// \" + summary, \"\", \"\", \"comment\"], [\"let project = Project {\", \"\", \"\", \"keyword\"], [\"    name: \", quotedName, \",\", \"string\"], [\"    stars: \", repo.stars || 0, \",\", \"number\"], [\"    forks: \", repo.forks || 0, \",\", \"number\"], [\"};\", \"\", \"\", \"plain\"]] }}",
                "javaRows": "{{ [[\"// \" + summary, \"\", \"\", \"comment\"], [\"var project = Map.of(\", \"\", \"\", \"keyword\"], [\"    \\\"name\\\", \", quotedName, \",\", \"string\"], [\"    \\\"stars\\\", \", repo.stars || 0, \",\", \"number\"], [\"    \\\"forks\\\", \", repo.forks || 0, \"\", \"number\"], [\");\", \"\", \"\", \"plain\"]] }}",
                "goRows": "{{ [[\"// \" + summary, \"\", \"\", \"comment\"], [\"project := map[string]any{\", \"\", \"\", \"keyword\"], [\"    \\\"name\\\": \", quotedName, \",\", \"string\"], [\"    \\\"stars\\\": \", repo.stars || 0, \",\", \"number\"], [\"    \\\"forks\\\": \", repo.forks || 0, \",\", \"number\"], [\"}\", \"\", \"\", \"plain\"]] }}",
                "typescriptRows": "{{ [[\"// \" + summary, \"\", \"\", \"comment\"], [\"const project = {\", \"\", \"\", \"keyword\"], [\"    name: \", quotedName, \",\", \"string\"], [\"    stars: \", repo.stars || 0, \",\", \"number\"], [\"    forks: \", repo.forks || 0, \",\", \"number\"], [\"};\", \"\", \"\", \"plain\"]] }}",
                "javascriptRows": "{{ [[\"// \" + summary, \"\", \"\", \"comment\"], [\"const project = {\", \"\", \"\", \"keyword\"], [\"    name: \", quotedName, \",\", \"string\"], [\"    stars: \", repo.stars || 0, \",\", \"number\"], [\"    forks: \", repo.forks || 0, \",\", \"number\"], [\"};\", \"\", \"\", \"plain\"]] }}",
                "shellRows": "{{ [[\"# \" + summary, \"\", \"\", \"comment\"], [\"PROJECT=\", quotedName, \"\", \"string\"], [\"STARS=\", repo.stars || 0, \"\", \"number\"], [\"FORKS=\", repo.forks || 0, \"\", \"number\"]] }}",
                "pythonRows": "{{ [[\"# \" + summary, \"\", \"\", \"comment\"], [\"project = {\", \"\", \"\", \"keyword\"], [\"    \\\"name\\\": \", quotedName, \",\", \"string\"], [\"    \\\"stars\\\": \", repo.stars || 0, \",\", \"number\"], [\"    \\\"forks\\\": \", repo.forks || 0, \",\", \"number\"], [\"}\", \"\", \"\", \"plain\"]] }}",
                "kotlinRows": "{{ [[\"// \" + summary, \"\", \"\", \"comment\"], [\"val project = mapOf(\", \"\", \"\", \"keyword\"], [\"    \\\"name\\\" to \", quotedName, \",\", \"string\"], [\"    \\\"stars\\\" to \", repo.stars || 0, \",\", \"number\"], [\"    \\\"forks\\\" to \", repo.forks || 0, \"\", \"number\"], [\")\", \"\", \"\", \"plain\"]] }}",
                "defaultRows": "{{ [[\"name: \", repo.name, \"\", \"string\"], [\"about: \", (summary | truncateWidth(300, \"mono\", 11)), \"\", \"plain\"], [\"stars: \", repo.stars || 0, \"\", \"number\"], [\"forks: \", repo.forks || 0, \"\", \"number\"]] }}",
                "codeRows": "{{ language == \"Rust\" ? rustRows : language == \"Java\" ? javaRows : language == \"Go\" ? goRows : language == \"TypeScript\" ? typescriptRows : language == \"JavaScript\" ? javascriptRows : language == \"Shell\" ? shellRows : language == \"Python\" ? pythonRows : language == \"Kotlin\" ? kotlinRows : defaultRows }}"
              },
              "children": [
                {
                  "type": "text",
                  "x": 16,
                  "y": 11.6,
                  "content": "{{ (repo.name | truncateWidth(280, \"mono\", 11.5)) + extension }}",
                  "font": "mono",
                  "fontSize": 11.5,
                  "fill": "{{ props.theme == \"dark\" ? \"#C9C9CF\" : \"#3F3F46\" }}"
                },
                {
                  "type": "rect",
                  "x": 0,
                  "y": 36,
                  "width": 412,
                  "height": 1,
                  "fill": "{{ props.theme == \"dark\" ? \"#26272B\" : \"#E4E4E7\" }}"
                },
                {
                  "type": "group",
                  "repeat": {
                    "each": "{{ codeRows }}",
                    "as": "codeRow",
                    "index": "lineIndex"
                  },
                  "children": [
                    {
                      "type": "text",
                      "x": 16,
                      "y": "{{ 50 + lineIndex * 19 }}",
                      "content": "{{ lineIndex + 1 }}",
                      "font": "mono",
                      "fontSize": 11,
                      "fill": "{{ props.theme == \"dark\" ? \"#8B8B94\" : \"#71717A\" }}"
                    },
                    {
                      "type": "text",
                      "x": 40,
                      "y": "{{ 50 + lineIndex * 19 }}",
                      "content": "{{ codeRow[0] }}",
                      "font": "mono",
                      "fontSize": 11,
                      "fill": "{{ codeRow[3] == \"comment\" ? (props.theme == \"dark\" ? \"#8B8B94\" : \"#71717A\") : (codeRow[3] == \"keyword\" ? (props.theme == \"dark\" ? \"#CC7832\" : \"#0033B3\") : (props.theme == \"dark\" ? \"#C9C9CF\" : \"#3F3F46\")) }}"
                    },
                    {
                      "type": "text",
                      "x": "{{ 40 + (codeRow[0] | textWidth(\"mono\", 11)) }}",
                      "y": "{{ 50 + lineIndex * 19 }}",
                      "content": "{{ codeRow[1] }}",
                      "font": "mono",
                      "fontSize": 11,
                      "fill": "{{ codeRow[3] == \"number\" ? (props.theme == \"dark\" ? \"#6897BB\" : \"#1750EB\") : (props.theme == \"dark\" ? \"#8CB070\" : \"#067D17\") }}"
                    },
                    {
                      "type": "text",
                      "x": "{{ 40 + (codeRow[0] | textWidth(\"mono\", 11)) + (codeRow[1] | padStart(0) | textWidth(\"mono\", 11)) }}",
                      "y": "{{ 50 + lineIndex * 19 }}",
                      "content": "{{ codeRow[2] }}",
                      "font": "mono",
                      "fontSize": 11,
                      "fill": "{{ props.theme == \"dark\" ? \"#C9C9CF\" : \"#3F3F46\" }}"
                    }
                  ]
                },
                {
                  "type": "ellipse",
                  "x": 16,
                  "y": 183,
                  "width": 7,
                  "height": 7,
                  "fill": "{{ repo.primaryLanguage.color || (props.theme == \"dark\" ? \"#8B8B94\" : \"#71717A\") }}"
                },
                {
                  "type": "text",
                  "x": 30,
                  "y": 180,
                  "content": "{{ language }}",
                  "font": "mono",
                  "fontSize": 10,
                  "fill": "{{ props.theme == \"dark\" ? \"#8B8B94\" : \"#71717A\" }}"
                },
                {
                  "type": "text",
                  "x": 190,
                  "y": 180,
                  "content": "{{ repo.isArchived ? \"archived\" : \"\" }}",
                  "font": "mono",
                  "fontSize": 10,
                  "fill": "{{ props.theme == \"dark\" ? \"#8B8B94\" : \"#71717A\" }}",
                  "width": 206,
                  "align": "end"
                }
              ]
            },
            {
              "type": "group",
              "if": "{{ !repo }}",
              "children": [
                {
                  "type": "text",
                  "x": 16,
                  "y": 11.6,
                  "content": "empty",
                  "font": "mono",
                  "fontSize": 11.5,
                  "fill": "{{ props.theme == \"dark\" ? \"#C9C9CF\" : \"#3F3F46\" }}"
                },
                {
                  "type": "text",
                  "x": 16,
                  "y": 51.5,
                  "content": "// no repository in this slot yet",
                  "font": "mono",
                  "fontSize": 11,
                  "fill": "{{ props.theme == \"dark\" ? \"#8B8B94\" : \"#71717A\" }}"
                }
              ]
            }
          ]
        }
      ]
    }
  },
  "layers": [
    {
      "type": "component",
      "ref": "card",
      "props": {
        "theme": "light",
        "slot": 0
      }
    }
  ]
}
